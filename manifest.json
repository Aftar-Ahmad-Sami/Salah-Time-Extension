{
    "manifest_version": 3,
    "name": "Salah Time",
    "version": "1.1.0",
    "description": "Muslim prayer (Salah) times with a live countdown, Hijri date and Qibla direction",
    "permissions": ["geolocation"],
    "browser_specific_settings": {
      "gecko": {
        "id": "salah-time@aftar-ahmad-sami",
        "strict_min_version": "140.0",
        "data_collection_permissions": {
          "required": ["locationInfo"]
        }
      }
    },
    "action": {
      "default_popup": "src/html/popup.html",
      "default_icon": {
        "16": "icons/icons8-mosque-flat-16.png",
        "32": "icons/icons8-mosque-flat-32.png",
        "48": "icons/icons8-mosque-flat-48.png",
        "128": "icons/icons8-mosque-flat-128.png"
      }
    },
    "icons": {
      "16": "icons/icons8-mosque-flat-16.png",
      "32": "icons/icons8-mosque-flat-32.png",
      "48": "icons/icons8-mosque-flat-48.png",
      "128": "icons/icons8-mosque-flat-128.png"
    }
  }